# Reversing control flow.
#
# `rev x` steps one variable back. `rev` on its own steps one whole statement
# back: an if reverses whichever branch actually ran, and a loop reverses every
# iteration it actually performed.

# A branch that destroys the variable its own condition tested. Re-running the
# condition afterwards gives the wrong answer, because x is no longer 10.
x = 10
print(`start        x =`, x)

if x > 5:
    x = x - 6
else:
    x = x + 100

print(`after branch x =`, x)
rev
print(`after rev    x =`, x)

print(`---------------------------------------`)

# A loop with a branch inside it that only fires on some iterations.
k = 0
total = 0
for k in range(1, 6):
    total += k
    if total > 6:
        total += 100

print(`after loop   k =`, k, ` total =`, total)
rev
print(`after rev    k =`, k, ` total =`, total)

print(`---------------------------------------`)

# A loop whose body only adds and subtracts is recorded once for the whole run
# rather than once per iteration, because the steps compose: a thousand
# `n += 1` undo as a single `n -= 1000`. Reversing it costs the same whether it
# went round ten times or ten thousand.
n = 0
d = 5000
while n < 1000:
    n += 1
    d -= 3

print(`after loop   n =`, n, ` d =`, d)
rev
print(`after rev    n =`, n, ` d =`, d)

print(`---------------------------------------`)

# Repeating rev walks back through the block one statement at a time.
p = 0
p += 3
p += 10
p += 100
print(`forward      p =`, p)
rev
print(`back one     p =`, p)
rev
print(`back two     p =`, p)
rev
print(`back three   p =`, p)
